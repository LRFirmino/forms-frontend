      <div id="thankyou-screen" class="hidden text-center py-10 space-y-5">
        <div
          class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-inner">
          <i data-lucide="check" class="w-8 h-8"></i>
        </div>
        <div class="space-y-2">
          <h2 class="text-2xl font-bold text-slate-900">Resposta Registrada!</h2>
          <p class="text-slate-600 text-sm max-w-md mx-auto leading-relaxed">
            Muito obrigado por dedicar alguns minutos do seu tempo. Suas respostas são extremamente valiosas para nos
            ajudar a entender os desafios de quem dá aulas particulares.
          </p>
        </div>
        <div class="pt-4 border-t border-slate-100">
          <p class="text-xs text-slate-400">Você já pode fechar esta aba.</p>
        </div>
      </div>

      <!-- TELA DE DESQUALIFICAÇÃO -->
      <div id="disqualified-screen" class="hidden text-center py-10 space-y-4">
        <div class="w-12 h-12 bg-slate-100 text-slate-500 rounded-full flex items-center justify-center mx-auto">
          <i data-lucide="user-x" class="w-6 h-6"></i>
        </div>
        <h2 class="text-xl font-bold text-slate-800">Obrigado pelo interesse!</h2>
        <p class="text-slate-600 text-sm max-w-sm mx-auto">
          No momento esta pesquisa é voltada exclusivamente para quem leciona aulas particulares ativamente. Agradecemos
          sua atenção!
        </p>
      </div>

    </div>
  </main>

  <!-- RODAPÉ -->
  <footer class="text-center py-6 text-xs text-slate-400 border-t border-slate-200 bg-white">
    <p>Pesquisa de Descoberta de Produto &bull; Dados confidenciais e protegidos</p>
  </footer>

  <!-- LÓGICA JAVASCRIPT -->
  <script>
    let currentStep = 1;
    const totalSteps = 4;

    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();
      attachInputListeners();
    });

    // Remove destaque de erro ao responder a pergunta
    function attachInputListeners() {
      document.querySelectorAll('input, select, textarea').forEach(input => {
        input.addEventListener('change', () => {
          const block = input.closest('.question-block');
          if (block) block.classList.remove('field-error');
          hideError();
        });
        if (input.tagName === 'TEXTAREA' || input.type === 'text') {
          input.addEventListener('input', () => {
            const block = input.closest('.question-block');
            if (block && input.value.trim().length > 0) {
              block.classList.remove('field-error');
              hideError();
            }
          });
        }
      });
    }

    // Navegação entre etapas
    function changeStep(delta) {
      if (delta > 0) {
        const firstUnansweredBlock = getFirstUnansweredBlock();
        if (firstUnansweredBlock) {
          showError("Por favor, responda a pergunta destacada antes de prosseguir.");
          highlightAndScrollToBlock(firstUnansweredBlock);
          return;
        }
      }

      hideError();

      if (currentStep === 1 && delta > 0) {
        const p1Val = document.querySelector('input[name="p1_aulas"]:checked')?.value;
        if (p1Val === 'Não') {
          showDisqualifiedScreen();
          return;
        }
      }

      const newStep = currentStep + delta;

      if (newStep >= 1 && newStep <= totalSteps) {
        document.getElementById(`step-${currentStep}`).classList.remove('active');
        currentStep = newStep;
        document.getElementById(`step-${currentStep}`).classList.add('active');
        updateUI();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    // Localiza e retorna o primeiro elemento não respondido na etapa atual
    function getFirstUnansweredBlock() {
      // Limpa erros anteriores
      document.querySelectorAll('.field-error').forEach(el => el.classList.remove('field-error'));

      if (currentStep === 1) {
        if (!document.querySelector('input[name="p1_aulas"]:checked')) {
          return document.getElementById('block-p1');
        }
        const p1Val = document.querySelector('input[name="p1_aulas"]:checked').value;
        if (p1Val !== 'Não') {
          const p2Checked = document.querySelectorAll('input[name="p2_disciplinas"]:checked').length > 0;
          const p2Outro = document.getElementById('p2_outro').value.trim().length > 0;
          if (!p2Checked && !p2Outro) return document.getElementById('block-p2');

          if (!document.querySelector('select[name="p3_qtd_alunos"]').value) {
            return document.getElementById('block-p3');
          }

          const p4Checked = document.querySelectorAll('input[name="p4_meios_cobranca"]:checked').length > 0;
          const p4Outro = document.getElementById('p4_outro').value.trim().length > 0;
          if (!p4Checked && !p4Outro) return document.getElementById('block-p4');
        }
      }
      else if (currentStep === 2) {
        if (document.querySelectorAll('input[name="p5_ferramentas_controle"]:checked').length === 0) {
          return document.getElementById('block-p5');
        }
        if (!document.querySelector('textarea[name="p6_identificacao_pagamento"]').value.trim()) {
          return document.getElementById('block-p6');
        }
        if (!document.querySelector('input[name="p6_frequencia_problemas"]:checked')) {
          return document.getElementById('block-p6-sub');
        }
        if (!document.querySelector('select[name="p7_frequencia_checagem"]').value) {
          return document.getElementById('block-p7');
        }
        if (!document.querySelector('select[name="p8_tempo_gasto_mes"]').value) {
          return document.getElementById('block-p8');
        }
        if (!document.querySelector('input[name="p9_acao_inadimplencia"]:checked')) {
          return document.getElementById('block-p9');
        }
        if (!document.querySelector('textarea[name="p10_pior_parte"]').value.trim()) {
          return document.getElementById('block-p10');
        }
      }
      else if (currentStep === 3) {
        if (!document.querySelector('input[name="p11_cenario_mais_util"]:checked')) {
          return document.getElementById('block-p11');
        }
        if (!document.querySelector('input[name="p13_trabalho_eliminar"]').value.trim()) {
          return document.getElementById('block-p13');
        }
      }
      else if (currentStep === 4) {
        if (!document.querySelector('input[name="p14_faixa_preco"]:checked')) {
          return document.getElementById('block-p14');
        }
        if (!document.querySelector('input[name="p15_interesse_beta"]:checked')) {
          return document.getElementById('block-p15');
        }
      }

      return null;
    }

    // Aplica destaque e Rola Smoothmente até o elemento pendente
    function highlightAndScrollToBlock(element) {
      if (!element) return;

      element.classList.add('field-error');

      // Rola a tela considerando a barra do topo (offset de 100px)
      const elementPosition = element.getBoundingClientRect().top + window.pageYOffset;
      const offsetPosition = elementPosition - 100;

      window.scrollTo({
        top: offsetPosition,
        behavior: 'smooth'
      });
    }

    function updateUI() {
      const pct = (currentStep / totalSteps) * 100;
      document.getElementById('progress-bar').style.width = `${pct}%`;

      const btnPrev = document.getElementById('btn-prev');
      if (currentStep > 1) {
        btnPrev.classList.remove('hidden');
      } else {
        btnPrev.classList.add('hidden');
      }

      const btnNext = document.getElementById('btn-next');
      const btnSubmit = document.getElementById('btn-submit');

      if (currentStep === totalSteps) {
        btnNext.classList.add('hidden');
        btnSubmit.classList.remove('hidden');
      } else {
        btnNext.classList.remove('hidden');
        btnSubmit.classList.add('hidden');
      }
    }

    function toggleContactFields(show) {
      const el = document.getElementById('contact-fields');
      if (show) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    }

    function moveRank(button, delta) {
      const item = button.closest('.ranking-item');
      const container = document.getElementById('ranking-container');
      const items = Array.from(container.children);
      const index = items.indexOf(item);

      if (delta === -1 && index > 0) {
        container.insertBefore(item, items[index - 1]);
      } else if (delta === 1 && index < items.length - 1) {
        container.insertBefore(items[index + 1], item);
      }

      Array.from(container.children).forEach((el, idx) => {
        el.querySelector('.rank-number').textContent = idx + 1;
      });
    }

    function showError(msg) {
      const errBox = document.getElementById('error-message');
      document.getElementById('error-text').innerText = msg;
      errBox.classList.remove('hidden');
    }

    function hideError() {
      document.getElementById('error-message').classList.add('hidden');
    }

    function showDisqualifiedScreen() {
      document.getElementById('discovery-form').classList.add('hidden');
      document.getElementById('disqualified-screen').classList.remove('hidden');
      document.getElementById('progress-bar').style.width = '100%';
    }

    async function submitForm() {
      const hpValue = document.getElementById('website')?.value;
      if (hpValue) {
        showThankYouScreen();
        return;
      }

      // 2. Validação dos blocos obrigatórios
      const firstUnansweredBlock = getFirstUnansweredBlock();
      if (firstUnansweredBlock) {
        showError("Por favor, responda a pergunta destacada antes de enviar.");
        highlightAndScrollToBlock(firstUnansweredBlock);
        return;
      }

      hideError();


      // Substitua a construção do payload por esta versão plana:
      const rankingItems = Array.from(document.querySelectorAll('#ranking-container .ranking-item'))
        .map(el => el.getAttribute('data-id'));

      const disciplinasChecked = Array.from(document.querySelectorAll('input[name="p2_disciplinas"]:checked')).map(c => c.value);

      const meiosChecked = Array.from(document.querySelectorAll('input[name="p4_meios_cobranca"]:checked')).map(c => c.value);

      const ferramentasChecked = Array.from(document.querySelectorAll('input[name="p5_ferramentas_controle"]:checked')).map(c => c.value);

      const payload = {
        p1_aulas: document.querySelector('input[name="p1_aulas"]:checked')?.value || '',
        p2_disciplinas: disciplinasChecked,
        p2_outro: document.getElementById('p2_outro')?.value.trim() || '',
        p3_qtd_alunos: document.querySelector('select[name="p3_qtd_alunos"]')?.value || '',
        p4_meios_cobranca: meiosChecked,
        p4_outro: document.getElementById('p4_outro')?.value.trim() || '',
        p5_ferramentas_controle: ferramentasChecked,
        p6_identificacao_pagamento: document.querySelector('textarea[name="p6_identificacao_pagamento"]')?.value || '',
        p6_frequencia_problemas: document.querySelector('input[name="p6_frequencia_problemas"]:checked')?.value || '',
        p7_frequencia_checagem: document.querySelector('select[name="p7_frequencia_checagem"]')?.value || '',
        p8_tempo_gasto_mes: document.querySelector('select[name="p8_tempo_gasto_mes"]')?.value || '',
        p9_acao_inadimplencia: document.querySelector('input[name="p9_acao_inadimplencia"]:checked')?.value || '',
        p10_pior_parte: document.querySelector('textarea[name="p10_pior_parte"]')?.value || '',
        p11_cenario_mais_util: document.querySelector('input[name="p11_cenario_mais_util"]:checked')?.value || '',
        p12_ranking: rankingItems,
        p13_trabalho_eliminar: document.querySelector('input[name="p13_trabalho_eliminar"]')?.value || '',
        p14_faixa_preco: document.querySelector('input[name="p14_faixa_preco"]:checked')?.value || '',
        p15_interesse_beta: document.querySelector('input[name="p15_interesse_beta"]:checked')?.value || '',
        contato_nome: document.getElementById('contato_nome')?.value || '',
        contato_canal: document.getElementById('contato_canal')?.value || '',
        website: document.getElementById('website')?.value || ''
      };

      const btnSubmit = document.getElementById('btn-submit');
      btnSubmit.disabled = true;
      btnSubmit.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i><span>Enviando...</span>`;
      lucide.createIcons();

      try {
        await fetch(CONFIG.API_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        showThankYouScreen();
      } catch (err) {
        console.error('Erro no envio:', err);
        showThankYouScreen();
      }
    }

    function showThankYouScreen() {
      document.getElementById('discovery-form').classList.add('hidden');
      document.getElementById('thankyou-screen').classList.remove('hidden');
      document.getElementById('progress-bar').style.width = '100%';
    }
  </script>
</body>

</html>
