<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pesquisa: Gestão e Pagamentos para Professores Particulares</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#f0f7ff',
              100: '#e0effe',
              200: '#bae0fd',
              500: '#0284c7',
              600: '#0284c7',
              700: '#0369a1',
              900: '#0c4a6e',
            }
          }
        }
      }
    }
  </script>

  <style>
    .step-content {
      display: none;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .step-content.active {
      display: block;
      opacity: 1;
      transform: translateY(0);
    }

    /* Efeito visual para a pergunta pendente */
    .field-error {
      border: 2px solid #ef4444 !important;
      border-radius: 0.75rem;
      padding: 0.75rem;
      background-color: #fef2f2;
      animation: shake 0.3s ease-in-out;
    }

    @keyframes shake {

      0%,
      100% {
        transform: translateX(0);
      }

      20%,
      60% {
        transform: translateX(-4px);
      }

      40%,
      80% {
        transform: translateX(4px);
      }
    }

    /* Responsive: mobile + desktop */
    html, body { width:100%; max-width:100%; overflow-x:hidden; }
    *, *::before, *::after { box-sizing:border-box; }
    input, select, textarea, button { max-width:100%; }
    @media (max-width: 767px) {
      header > div:first-child { padding:.75rem .875rem; }
      header .font-bold { font-size:.95rem; line-height:1.2; }
      main { width:100%; max-width:100%; padding:.75rem .625rem 1.25rem; }
      main > div { border-radius:1rem; padding:1rem; box-shadow:0 8px 24px rgba(15,23,42,.08); }
      .step-content h1, .step-content h2 { font-size:1.2rem; line-height:1.35; }
      .step-content > div:first-child { padding-bottom:.75rem; }
      .question-block label span { overflow-wrap:anywhere; }
      .grid.grid-cols-2, .grid.grid-cols-3, .grid.md\:grid-cols-2, .grid.md\:grid-cols-3 { grid-template-columns:minmax(0,1fr) !important; }
      #block-p6-sub .grid.grid-cols-5 { grid-template-columns:repeat(2,minmax(0,1fr)) !important; }
      #block-p6-sub .grid.grid-cols-5 label:last-child { grid-column:1/-1; }
      .ranking-item { gap:.5rem; align-items:center; }
      .ranking-item > span:first-child { min-width:0; flex:1; line-height:1.35; }
      .ranking-item > div { flex-shrink:0; }
      .ranking-item button { min-width:2rem; min-height:2rem; display:inline-flex; align-items:center; justify-content:center; }
      #btn-prev, #btn-next, #btn-submit { min-height:2.75rem; }
      footer { padding:1rem .75rem; line-height:1.5; }
    }
    @media (max-width:380px) {
      header .bg-slate-100 span { display:none; }
      header .bg-slate-100 { padding:.5rem; }
      main { padding-left:.4rem; padding-right:.4rem; }
      main > div { padding:.8rem; }
      .question-block { padding-left:0; padding-right:0; }
    }
  </style>
</head>

<body
  class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between selection:bg-brand-500 selection:text-white">

  <!-- CONFIGURAÇÃO DO BACKEND -->
  <script>
    const CONFIG = {
      API_ENDPOINT: 'https://forms-backend-chi.vercel.app/api/v1/survey'
    };
  </script>

  <!-- CABEÇALHO -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="bg-brand-600 text-white p-2 rounded-xl shadow-md shadow-brand-500/20">
          <i data-lucide="graduation-cap" class="w-5 h-5"></i>
        </div>
        <span class="font-bold text-slate-900 tracking-tight text-lg">Formulário de Pesquisa</span>
      </div>
      <div class="text-xs font-medium text-slate-500 bg-slate-100 px-3 py-1.5 rounded-full flex items-center gap-1.5">
        <i data-lucide="clock" class="w-3.5 h-3.5"></i>
        <span>3 a 5 min</span>
      </div>
    </div>

    <div class="w-full bg-slate-100 h-1.5 overflow-hidden">
      <div id="progress-bar" class="bg-brand-600 h-full w-1/4 transition-all duration-500 ease-out"></div>
    </div>
  </header>

  <!-- CONTEÚDO PRINCIPAL -->
  <main class="max-w-2xl mx-auto px-4 py-8 w-full flex-grow">

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xl shadow-slate-200/50 p-6 md:p-8">

      <!-- Mensagem de Erro Global -->
      <div id="error-message"
        class="hidden mb-6 p-4 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl flex items-center gap-3">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 text-red-500"></i>
        <span id="error-text">Por favor, responda a pergunta destacada abaixo antes de avançar.</span>
      </div>

      <form id="discovery-form" onsubmit="return false;">

        <!-- SEÇÃO 1 -->
        <div id="step-1" class="step-content active space-y-6">
          <div class="border-b border-slate-100 pb-4">
            <span
              class="text-xs font-bold uppercase tracking-wider text-brand-600 bg-brand-50 px-2.5 py-1 rounded-md">Etapa
              1 de 4</span>
            <h1 class="text-xl md:text-2xl font-bold text-slate-900 mt-2">Perfil e Atuação</h1>
            <p class="text-slate-500 text-sm mt-1">Queremos entender um pouco sobre a sua rotina como professor.</p>
          </div>

          <!-- P1 -->
          <div class="question-block space-y-3 p-1 transition-all rounded-xl" id="block-p1">
            <label class="block font-semibold text-slate-800 text-sm">
              1. Você dá aulas particulares atualmente? <span class="text-red-500">*</span>
            </label>
            <div class="grid grid-cols-1 gap-2.5">
              <label
                class="flex items-center p-3.5 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="radio" name="p1_aulas" value="Sim, exclusivamente"
                  class="text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-3 text-sm font-medium text-slate-700">Sim, exclusivamente</span>
              </label>
              <label
                class="flex items-center p-3.5 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="radio" name="p1_aulas" value="Sim, como atividade principal"
                  class="text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-3 text-sm font-medium text-slate-700">Sim, como atividade principal</span>
              </label>
              <label
                class="flex items-center p-3.5 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="radio" name="p1_aulas" value="Sim, como renda complementar"
                  class="text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-3 text-sm font-medium text-slate-700">Sim, como renda complementar</span>
              </label>
              <label
                class="flex items-center p-3.5 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="radio" name="p1_aulas" value="Não" class="text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-3 text-sm font-medium text-slate-700">Não dou aulas particulares no momento</span>
              </label>
            </div>
          </div>

          <!-- P2 -->
          <div class="question-block space-y-3 p-1 transition-all rounded-xl" id="block-p2">
            <label class="block font-semibold text-slate-800 text-sm">
              2. Que tipo de aula você dá? <span class="text-red-500">*</span>
              <span class="block text-xs font-normal text-slate-500 mt-0.5">(Pode marcar mais de uma opção)</span>
            </label>
            <div class="grid grid-cols-2 gap-2.5">
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p2_disciplinas" value="Inglês"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Inglês</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p2_disciplinas" value="Outros idiomas"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Outros idiomas</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p2_disciplinas" value="Matemática"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Matemática</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p2_disciplinas" value="Português"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Português</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p2_disciplinas" value="Física / Química"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Física / Química</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p2_disciplinas" value="Música"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Música</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p2_disciplinas" value="Programação / Tecnologia"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Programação / TI</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p2_disciplinas" value="Reforço escolar"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Reforço Escolar</span>
              </label>
            </div>
            <div class="mt-2">
              <input type="text" id="p2_outro" placeholder="Outra disciplina (opcional)"
                class="w-full text-sm p-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:outline-none">
            </div>
          </div>

          <!-- P3 -->
          <div class="question-block space-y-3 p-1 transition-all rounded-xl" id="block-p3">
            <label class="block font-semibold text-slate-800 text-sm">
              3. Quantos alunos você possui atualmente? <span class="text-red-500">*</span>
            </label>
            <select name="p3_qtd_alunos"
              class="w-full text-sm p-3.5 border border-slate-200 rounded-xl bg-white focus:ring-2 focus:ring-brand-500 focus:outline-none">
              <option value="" disabled selected>Selecione uma opção...</option>
              <option value="1–5">1 a 5 alunos</option>
              <option value="6–10">6 a 10 alunos</option>
              <option value="11–20">11 a 20 alunos</option>
              <option value="21–40">21 a 40 alunos</option>
              <option value="41–70">41 a 70 alunos</option>
              <option value="Mais de 70">Mais de 70 alunos</option>
            </select>
          </div>

          <!-- P4 -->
          <div class="question-block space-y-3 p-1 transition-all rounded-xl" id="block-p4">
            <label class="block font-semibold text-slate-800 text-sm">
              4. Como você normalmente cobra seus alunos? <span class="text-red-500">*</span>
              <span class="block text-xs font-normal text-slate-500 mt-0.5">(Marque todos os meios utilizados)</span>
            </label>
            <div class="grid grid-cols-2 gap-2.5">
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p4_meios_cobranca" value="Pix"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Pix</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p4_meios_cobranca" value="Transferência bancária"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Transferência (TED)</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p4_meios_cobranca" value="Boleto"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Boleto</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p4_meios_cobranca" value="Cartão de Crédito/Débito"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Cartão</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p4_meios_cobranca" value="Dinheiro"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Dinheiro em espécie</span>
              </label>
            </div>
            <input type="text" id="p4_outro" placeholder="Outra forma de pagamento (opcional)"
              class="w-full text-sm p-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:outline-none">
          </div>
        </div>

        <!-- SEÇÃO 2 -->
        <div id="step-2" class="step-content space-y-6">
          <div class="border-b border-slate-100 pb-4">
            <span
              class="text-xs font-bold uppercase tracking-wider text-brand-600 bg-brand-50 px-2.5 py-1 rounded-md">Etapa
              2 de 4</span>
            <h2 class="text-xl md:text-2xl font-bold text-slate-900 mt-2">Controle Financeiro e Rotina</h2>
            <p class="text-slate-500 text-sm mt-1">Queremos entender exatamente como você gerencia seus recebimentos no
              dia a dia.</p>
          </div>

          <!-- P5 -->
          <div class="question-block space-y-3 p-1 transition-all rounded-xl" id="block-p5">
            <label class="block font-semibold text-slate-800 text-sm">
              5. Como você controla quem já pagou e quem ainda está devendo? <span class="text-red-500">*</span>
              <span class="block text-xs font-normal text-slate-500 mt-0.5">(Marque todas as opções aplicáveis)</span>
            </label>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p5_ferramentas_controle" value="Planilha (Excel / Google Sheets)"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Planilha (Excel/Sheets)</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p5_ferramentas_controle" value="Caderno / Anotações no papel"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Caderno / Anotações papel</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p5_ferramentas_controle" value="Aplicativo financeiro genérico"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">App financeiro genérico</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p5_ferramentas_controle" value="Pelo próprio app do banco"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Pelo próprio app do Banco</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p5_ferramentas_controle" value="Memória"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Apenas de cabeça (Memória)</span>
              </label>
              <label
                class="flex items-center p-3 border border-slate-200 rounded-xl hover:bg-slate-50 cursor-pointer transition-all has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50/50">
                <input type="checkbox" name="p5_ferramentas_controle" value="Não tenho controle organizado"
                  class="rounded text-brand-600 focus:ring-brand-500 h-4 w-4">
                <span class="ml-2.5 text-sm text-slate-700">Não tenho controle organizado</span>
              </label>
            </div>
          </div>

          <!-- P6 -->
          <div class="question-block space-y-4 p-1 transition-all rounded-xl" id="block-p6">
            <div>
              <label class="block font-semibold text-slate-800 text-sm">
                6. Quando você recebe um pagamento, como sabe a qual aluno ele pertence? <span
                  class="text-red-500">*</span>
              </label>
              <textarea name="p6_identificacao_pagamento" rows="2"
                placeholder="Ex: O aluno manda o comprovante no WhatsApp, ou vejo o nome da mãe no extrato do banco..."
                class="w-full text-sm p-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:outline-none mt-2"></textarea>
            </div>

            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80 space-y-2" id="block-p6-sub">
              <label class="block font-medium text-slate-700 text-xs uppercase tracking-wider">
                Identificar de quem é o pagamento costuma dar algum problema/confusão? <span
                  class="text-red-500">*</span>
              </label>
              <div class="grid grid-cols-5 gap-1.5 text-center">
                <label class="cursor-pointer">
                  <input type="radio" name="p6_frequencia_problemas" value="Nunca" class="peer sr-only">
                  <div
                    class="p-2 border border-slate-200 bg-white rounded-lg text-xs font-medium text-slate-600 peer-checked:bg-brand-600 peer-checked:text-white peer-checked:border-brand-600">
                    Nunca</div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="p6_frequencia_problemas" value="Raramente" class="peer sr-only">
                  <div
                    class="p-2 border border-slate-200 bg-white rounded-lg text-xs font-medium text-slate-600 peer-checked:bg-brand-600 peer-checked:text-white peer-checked:border-brand-600">
                    Raramente</div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="p6_frequencia_problemas" value="Às vezes" class="peer sr-only">
                  <div
                    class="p-2 border border-slate-200 bg-white rounded-lg text-xs font-medium text-slate-600 peer-checked:bg-brand-600 peer-checked:text-white peer-checked:border-brand-600">
                    Às vezes</div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="p6_frequencia_problemas" value="Frequentemente" class="peer sr-only">
                  <div
                    class="p-2 border border-slate-200 bg-white rounded-lg text-xs font-medium text-slate-600 peer-checked:bg-brand-600 peer-checked:text-white peer-checked:border-brand-600">
                    Frequente</div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="p6_frequencia_problemas" value="Sempre" class="peer sr-only">
